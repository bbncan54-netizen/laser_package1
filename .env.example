# Copy to .env.local for local development, and set the same values as
# Environment Variables in the Vercel project for production.

# --- Database (Vercel Postgres / Neon) ---
# Provisioned automatically when you add a Vercel Postgres integration to
# this project; copy the values it generates. Without these set, the
# Admin Panel runs read-only against the static defaults in
# src/lib/business-data.ts and no changes are saved (see 04_ADMIN_SYSTEM.md §10).
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# --- Admin authentication ---
# Single admin account — no user table (see src/lib/auth/credentials.ts).
ADMIN_USERNAME=admin
# Generate with: node scripts/hash-password.mjs "your-new-password"
ADMIN_PASSWORD_HASH=

# --- Session signing ---
# Any long random string. Generate with: openssl rand -base64 32
SESSION_SECRET=
